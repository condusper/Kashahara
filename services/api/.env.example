# ---------------------------------------------------------------------------
# Kashahara API — copy to .env and replace every placeholder.
# Never commit a real .env file. Never put these values in the mobile app.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Use PostgreSQL in production. When omitted in development, the API uses an
# in-memory store and prints a prominent warning. Data is lost on restart.
DATABASE_URL=postgres://kashahara:kashahara@localhost:5432/kashahara

# Shared rate-limit store. Required when running more than one API instance
# (Render Key Value, Upstash, or any Redis-compatible URL). When omitted, each
# process keeps its own counters in memory.
REDIS_URL=redis://localhost:6379

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Start with TEST keys. A key starting with `sk_live_` charges real money and
# automatically disables simulated funding. The secret key must remain
# server-side and must never be added to the mobile app.
#
# Validate a pasted key without moving money:
#   npm run paystack:check --workspace @kashahara/api
# Verify a specific funding reference:
#   npm run paystack:check --workspace @kashahara/api -- KSH-FUND-XXXX
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Deep link Paystack redirects to after a successful payment. Use
# `{reference}` to insert the funding reference, or append it as a path segment.
# The mobile app also sends its own callback (an `exp://` URL in Expo Go), which
# takes precedence in development. In production this must be https or the
# kashahara:// app scheme.
PAYSTACK_CALLBACK_URL=kashahara://funding/{reference}

# Configure this exact URL in the Paystack dashboard (Webhooks):
#   https://<api-host>/api/v1/webhooks/paystack
# The webhook is signed with PAYSTACK_SECRET_KEY; there is no separate secret.

# VTU supplier adapter: mock | http | ogdams | bigisub
# `mock` is a development-only simulator. It never delivers real products.
# `bigisub` is the recommended wallet supplier: all four networks, cable TV,
# electricity, exam PINs and more. No SIM hosting or cloud profiles required.
# Purchases send the account's 4-digit transaction PIN; keep it server-side.
VTU_PROVIDER=mock
VTU_BASE_URL=
VTU_API_KEY=
OGDAMS_BASE_URL=https://simhosting.ogdams.ng/api/v1
OGDAMS_API_KEY=
OGDAMS_AIRTIME_TYPE=vtu
BIGISUB_BASE_URL=https://api.bigisub.ng
BIGISUB_API_TOKEN=
BIGISUB_TRANSACTION_PIN=

# Customer-facing margin on live data-plan prices, in percent. Prices round up
# to the next whole Naira. Set 0 to sell at supplier cost.
DATA_MARKUP_PERCENT=3

# Airtime service fee, in percent of face value, rounded up to whole Naira.
# Airtime supplier discounts are thin, so this keeps every top-up profitable.
# AIRTIME_FEE_MIN_KOBO is the floor; 100 = ₦1.
AIRTIME_FEE_PERCENT=2.5
AIRTIME_FEE_MIN_KOBO=100

# Poll interval for processing/uncertain orders, in milliseconds. Bigisub has
# no webhooks, so this is the automatic reconciliation path. 0 disables it.
PURCHASE_RECONCILE_INTERVAL_MS=60000

# Development-only simulated wallet funding. Must be false in production.
ALLOW_SIMULATED_PAYMENTS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Development-only: return password-reset / verification codes in API responses
# so the flow can be exercised without an email or SMS provider.
ALLOW_DEV_CODES=true
